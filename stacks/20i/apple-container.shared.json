{
  "services": [
    {
      "name": "gateway",
      "image": "nginx:1.25-alpine",
      "mounts": [
        "${SHARED_GATEWAY_CONFIG_FILE}:/etc/nginx/conf.d/default.conf:ro",
        "${SHARED_GATEWAY_CERTS_DIR}:/etc/nginx/certs:ro"
      ],
      "ports": [
        "127.0.0.1:${SHARED_GATEWAY_HTTP_PORT}:80",
        "127.0.0.1:${SHARED_GATEWAY_HTTPS_PORT}:443"
      ],
      "health": {
        "command": ["wget", "-qO-", "http://127.0.0.1/"],
        "interval": "1s",
        "retries": 30
      }
    }
  ]
}
